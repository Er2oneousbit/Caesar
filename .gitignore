# Dependencies
node_modules/

# Test output (screenshots etc.)
tests/e2e/out/

# Local Claude Code notes (personal; the repo is public)
CLAUDE.md

# Local reference clones of Julius and Augustus. They are AGPL-3.0 and this
# repo is MIT: never commit them and never copy their code (rules may be
# learned from them and written down in our own words, never the code).
/julius/
/augustus/

# Local analyst specs drawn from those references (drafts stay local)
/research/

# Claude Code's working copies for parallel agents (git worktrees)
.claude/worktrees/

# Saved games kept for debugging (exported save files; personal)
/Debug Games/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.log

# Artifact variant of the build (regenerate with: npm run build -- --artifact)
dist/colonia.artifact.html

# NOTE: dist/colonia.html IS committed on purpose, so players can download
# and double-click it without installing anything. Rebuild with `npm run build`.

# Throwaway probe scripts while investigating (never committed)
/scripts/_*_tmp.mjs
