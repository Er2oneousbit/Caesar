{
  "name": "colonia",
  "version": "0.15.9",
  "description": "Colonia: an original, open-source browser city builder inspired by classic Roman city-building games (Caesar III style): housing, services, trade by land and sea, and a military with walls, forts and cavalry.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "er2oneousbit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Er2oneousbit/Caesar.git"
  },
  "homepage": "https://github.com/Er2oneousbit/Caesar#readme",
  "bugs": {
    "url": "https://github.com/Er2oneousbit/Caesar/issues"
  },
  "keywords": [
    "city-builder",
    "game",
    "browser-game",
    "canvas",
    "isometric",
    "roman",
    "simulation"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs --open",
    "serve": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:e2e": "node tests/e2e/smoke.mjs",
    "screenshots": "node tests/e2e/screenshots.mjs",
    "sim": "node scripts/simulate.mjs",
    "sweep": "node scripts/sweep.mjs",
    "check": "npm test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
